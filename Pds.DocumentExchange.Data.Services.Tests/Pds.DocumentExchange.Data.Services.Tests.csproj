<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>

    <LangVersion>8</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Unit\Helpers\**" />
    <EmbeddedResource Remove="Unit\Helpers\**" />
    <None Remove="Unit\Helpers\**" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="FluentAssertions" Version="7.2.2" />
	<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
	<PackageReference Include="Moq" Version="4.21.0" />
	<PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
	<PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
	<PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Pds.Core.CodeAnalysis.StyleCop" Version="2.0.0" />
    <PackageReference Include="Pds.Core.Common" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pds.DocumentExchange.Data.Services\Pds.DocumentExchange.Data.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Unit\Providers\" />
    <Folder Include="Unit\Factories\" />
    <Folder Include="TestHelpers\" />
    <Folder Include="Unit\Extensions\" />
    <Folder Include="Unit\Converters\" />
    <Folder Include="Assets\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\asset_text_test.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
